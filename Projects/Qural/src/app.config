<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <!-- 4.6.2 — минимум для WebView2; более новые версии .NET Framework тоже подходят -->
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.2"/>
  </startup>
  <runtime>
    <!-- Qural почти всё время ждёт клавиш: фоновый поток сборщика мусора ему не нужен -->
    <gcConcurrent enabled="false"/>
  </runtime>
</configuration>
